{
  "manifest_version": 3,
  "name": "GitHub Issue Toolkit",
  "short_name": "Issue Tools",
  "version": "2.0.1",
  "description": "Custom issue field values and issue age as badges on GitHub sub-issue lists and Projects views, plus a pinned epics panel.",
  "author": "Miloš Paunović",
  "homepage_url": "https://milospaunovic.github.io/github-issue-toolkit/",
  "browser_specific_settings": {
    "gecko": {
      "id": "github-issue-toolkit@milospaunovic.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "GitHub Issue Toolkit - open settings"
  },
  "icons": {
    "16": "icons/icon-dark-16.png",
    "32": "icons/icon-dark-32.png",
    "48": "icons/icon-dark-48.png",
    "128": "icons/icon-dark-128.png"
  }
}
